# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/
wheels/

# Local virtual environments
.venv/
venv/
env/
ENV/

# Test, coverage, lint, and type-check caches
.pytest_cache/
.hypothesis/
.mypy_cache/
.pyright/
.pyre/
.pytype/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local environment files and credentials
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.secrets.*
secrets/
.secrets/
config/local/
config/*.local.*

# Runtime databases and SQLite sidecar files
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# Security-sensitive runtime data; schemas and migrations belong under src/
data/
runtime-data/
artifacts/
quarantine/
secret-store/

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# IDE and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
