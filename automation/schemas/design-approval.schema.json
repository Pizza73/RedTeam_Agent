{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/redteam-agent/design-approval.schema.json",
  "title": "RedTeam Agent Design Resume Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "head_sha",
    "blocked_gate_reference",
    "design_commit_sha",
    "design_reference",
    "policy_digest",
    "approved_by"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "phase": {"pattern": "^phase-(0b|0c|[1-3])$", "type": "string"},
    "head_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "blocked_gate_reference": {
      "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+#issuecomment-[0-9]+$",
      "type": "string"
    },
    "design_commit_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "design_reference": {
      "pattern": "^https://github\\.com/[^/]+/[^/]+/(?:pull/[0-9]+|blob/[0-9a-f]{40}/[^#]+)(?:#.*)?$",
      "type": "string"
    },
    "policy_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "approved_by": {"minLength": 1, "maxLength": 100, "type": "string"}
  }
}
