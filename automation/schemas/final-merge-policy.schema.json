{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/redteam-agent/final-merge-policy.schema.json",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "enabled": {"type": "boolean"},
    "merge_method": {"const": "merge"},
    "claim_ref_prefix": {"const": "refs/redteam-final-merge-attempts"},
    "required_phase": {"const": "phase-5"},
    "required_labels": {
      "const": ["ai-loop", "ai-project-complete", "ai-review-passed", "phase-5"]
    },
    "forbidden_labels": {
      "const": [
        "governance-change",
        "ai-human-gate",
        "ai-loop-blocked",
        "ai-needs-fix",
        "ai-needs-implementation",
        "ai-needs-review"
      ]
    },
    "required_checks": {
      "const": ["tests (3.12)", "tests (3.14)", "quality", "governance-integrity"]
    },
    "phase_status_context": {"const": "redteam/phase-review"},
    "trusted_record_author": {"const": "github-actions[bot]"},
    "approver_variable": {"const": "AI_GATE_APPROVER_LOGIN"},
    "reviewer_variable": {"const": "AI_REVIEWER_LOGIN"}
  },
  "required": [
    "schema_version",
    "enabled",
    "merge_method",
    "claim_ref_prefix",
    "required_phase",
    "required_labels",
    "forbidden_labels",
    "required_checks",
    "phase_status_context",
    "trusted_record_author",
    "approver_variable",
    "reviewer_variable"
  ],
  "type": "object"
}
