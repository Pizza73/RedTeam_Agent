{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/redteam-agent/implementation-request.schema.json",
  "title": "RedTeam Agent Implementation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action", "trigger", "phase", "head_sha", "phase_prompt"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "action": {"enum": ["IMPLEMENT_PHASE", "FIX_REVIEW_FINDINGS"]},
    "phase": {"pattern": "^phase-(0a|0b|0c|[1-5])$", "type": "string"},
    "head_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "phase_prompt": {"pattern": "^prompts/phases/[a-z0-9-]+\\.md$", "type": "string"},
    "design_approval_reference": {
      "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+#issuecomment-[0-9]+$",
      "type": "string"
    },
    "invariant_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "required"],
      "properties": {
        "policy_version": {"const": "1.0"},
        "required": {"const": true}
      }
    },
    "trigger": {
      "enum": [
        "PHASE_START",
        "CI_FAILURE",
        "HUMAN_GATE",
        "HUMAN_RESUME",
        "RESUME_AFTER_DESIGN_APPROVAL",
        "REVIEW_FINDINGS"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_sha",
        "review_reference",
        "finding_key",
        "finding_count",
        "findings",
        "summary"
      ],
      "properties": {
        "reviewed_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "review_reference": {
          "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+(?:[#/].*)?$",
          "type": "string"
        },
        "finding_key": {"pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}$", "type": "string"},
        "finding_count": {"minimum": 1, "maximum": 100, "type": "integer"},
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding_key", "finding_reference"],
            "properties": {
              "finding_key": {
                "pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}$",
                "type": "string"
              },
              "finding_reference": {
                "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+(?:[#/].*)?$",
                "type": "string"
              },
              "invariant_family": {
                "pattern": "^[a-z][a-z0-9-]{2,63}$",
                "type": "string"
              }
            }
          }
        },
        "summary": {"minLength": 1, "maxLength": 500, "type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "FIX_REVIEW_FINDINGS"}}},
      "then": {"required": ["review"]}
    },
    {
      "if": {"properties": {"action": {"const": "IMPLEMENT_PHASE"}}},
      "then": {"not": {"required": ["review"]}}
    },
    {
      "if": {
        "required": ["trigger"],
        "properties": {"trigger": {"const": "RESUME_AFTER_DESIGN_APPROVAL"}}
      },
      "then": {
        "required": ["design_approval_reference"],
        "properties": {"action": {"const": "IMPLEMENT_PHASE"}}
      },
      "else": {"not": {"required": ["design_approval_reference"]}}
    }
  ]
}
