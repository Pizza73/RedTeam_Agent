{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/redteam-agent/invariant-audit.schema.json",
  "title": "RedTeam Agent pre-review invariant-family audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "request", "families", "cross_family_tests", "notes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "phase": {"pattern": "^phase-(0a|0b|0c|[1-5])$", "type": "string"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_sha", "reference", "action"],
      "properties": {
        "head_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "reference": {
          "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+(?:[#/].*)?$",
          "type": "string"
        },
        "action": {"enum": ["IMPLEMENT_PHASE", "FIX_REVIEW_FINDINGS"]}
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "status", "entry_points", "sibling_paths", "invariant_evidence",
          "tests", "test_modes"
        ],
        "properties": {
          "id": {"pattern": "^[a-z][a-z0-9-]{2,63}$", "type": "string"},
          "status": {"enum": ["affected", "verified-unchanged"]},
          "entry_points": {
            "type": "array", "minItems": 1,
            "items": {"minLength": 1, "type": "string"}
          },
          "sibling_paths": {
            "type": "array", "minItems": 1,
            "items": {"minLength": 1, "type": "string"}
          },
          "invariant_evidence": {
            "type": "array", "minItems": 1,
            "items": {"minLength": 1, "type": "string"}
          },
          "tests": {
            "type": "array", "minItems": 1,
            "items": {"pattern": "^tests/.+\\.py$", "type": "string"}
          },
          "test_modes": {
            "type": "array", "minItems": 3, "uniqueItems": true,
            "items": {
              "enum": ["positive", "negative", "failure", "property", "state-machine"]
            }
          }
        }
      }
    },
    "cross_family_tests": {
      "type": "array", "minItems": 1,
      "items": {"pattern": "^tests/.+\\.py$", "type": "string"}
    },
    "notes": {"minLength": 1, "maxLength": 2000, "type": "string"}
  }
}
