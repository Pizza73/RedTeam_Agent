{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/redteam-agent/invariant-audit.schema.json",
  "title": "RedTeam Agent pre-review invariant-family audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "request", "families", "cross_family_tests", "notes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "phase": {"pattern": "^phase-(0a|0b|0c|[1-5])$", "type": "string"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_sha", "reference", "action"],
      "properties": {
        "head_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "reference": {
          "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+(?:[#/].*)?$",
          "type": "string"
        },
        "action": {"enum": ["IMPLEMENT_PHASE", "FIX_REVIEW_FINDINGS"]}
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "status", "entry_points", "sibling_paths", "invariant_evidence",
          "tests", "test_modes"
        ],
        "properties": {
          "id": {"pattern": "^[a-z][a-z0-9-]{2,63}$", "type": "string"},
          "status": {"enum": ["affected", "verified-unchanged"]},
          "entry_points": {
            "type": "array", "minItems": 1,
            "items": {"minLength": 1, "type": "string"}
          },
          "sibling_paths": {
            "type": "array", "minItems": 1,
            "items": {"minLength": 1, "type": "string"}
          },
          "invariant_evidence": {
            "type": "array", "minItems": 1,
            "items": {"minLength": 1, "type": "string"}
          },
          "tests": {
            "type": "array", "minItems": 1,
            "items": {"pattern": "^tests/.+\\.py$", "type": "string"}
          },
          "test_modes": {
            "type": "array", "minItems": 3, "uniqueItems": true,
            "items": {
              "enum": ["positive", "negative", "failure", "property", "state-machine"]
            }
          }
        }
      }
    },
    "cross_family_tests": {
      "type": "array", "minItems": 1,
      "items": {"pattern": "^tests/.+\\.py$", "type": "string"}
    },
    "notes": {"minLength": 1, "maxLength": 2000, "type": "string"},
    "implementation_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "units"],
      "properties": {
        "version": {"const": "1.0"},
        "units": {
          "type": "array", "minItems": 1, "maxItems": 200,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": [
              "id", "owner", "disposition", "rationale", "input_paths", "output_paths",
              "entry_points", "sibling_paths", "specification_refs", "invariant_families",
              "state_migration", "preserved_tests", "tests", "test_modes", "change_summary"
            ],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
              "owner": {"$ref": "#/$defs/nonblank"},
              "disposition": {"enum": ["reuse", "replace", "new"]},
              "rationale": {"$ref": "#/$defs/nonblank"},
              "input_paths": {"$ref": "#/$defs/paths"},
              "output_paths": {"$ref": "#/$defs/nonemptyPaths"},
              "entry_points": {"$ref": "#/$defs/nonemptyPaths"},
              "sibling_paths": {"$ref": "#/$defs/paths"},
              "specification_refs": {"$ref": "#/$defs/nonemptyPaths"},
              "invariant_families": {"$ref": "#/$defs/nonemptyPaths"},
              "state_migration": {"$ref": "#/$defs/nonblank"},
              "preserved_tests": {"$ref": "#/$defs/nonblank"},
              "tests": {"$ref": "#/$defs/nonemptyPaths"},
              "test_modes": {
                "type": "array", "minItems": 3, "uniqueItems": true,
                "items": {"enum": ["positive", "negative", "failure", "property", "state-machine"]}
              },
              "change_summary": {"$ref": "#/$defs/nonblank"}
            },
            "allOf": [{
              "if": {"properties": {"disposition": {"const": "new"}}},
              "then": {"properties": {"input_paths": {"maxItems": 0}}},
              "else": {"properties": {"input_paths": {"minItems": 1}}}
            }]
          }
        }
      }
    }
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
    "paths": {"type": "array", "maxItems": 500, "uniqueItems": true, "items": {"$ref": "#/$defs/nonblank"}},
    "nonemptyPaths": {"allOf": [{"$ref": "#/$defs/paths"}], "minItems": 1}
  }
}
