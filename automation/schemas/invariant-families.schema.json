{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/redteam-agent/invariant-families.schema.json",
  "title": "RedTeam Agent invariant-family review policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "semantic_recurrence_limit", "families", "phases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "semantic_recurrence_limit": {"const": 2},
    "families": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "stateful", "review_questions"],
        "properties": {
          "id": {"pattern": "^[a-z][a-z0-9-]{2,63}$", "type": "string"},
          "title": {"minLength": 1, "type": "string"},
          "stateful": {"type": "boolean"},
          "review_questions": {
            "type": "array",
            "minItems": 2,
            "items": {"minLength": 1, "type": "string"}
          }
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase-0a", "phase-0b", "phase-0c", "phase-1",
        "phase-2", "phase-3", "phase-4", "phase-5"
      ],
      "properties": {
        "phase-0a": {"$ref": "#/$defs/familyList"},
        "phase-0b": {"$ref": "#/$defs/familyList"},
        "phase-0c": {"$ref": "#/$defs/familyList"},
        "phase-1": {"$ref": "#/$defs/familyList"},
        "phase-2": {"$ref": "#/$defs/familyList"},
        "phase-3": {"$ref": "#/$defs/familyList"},
        "phase-4": {"$ref": "#/$defs/familyList"},
        "phase-5": {"$ref": "#/$defs/familyList"}
      }
    }
  },
  "$defs": {
    "familyList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"pattern": "^[a-z][a-z0-9-]{2,63}$", "type": "string"}
    }
  }
}
