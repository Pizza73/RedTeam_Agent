{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:redteam-agent:tuoni-credential:v1",
  "title": "Tuoni systemd encrypted credential plaintext input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version_id",
    "username",
    "password"
  ],
  "properties": {
    "version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[!-~]+$"
    },
    "username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[\\u0020-\\u0039\\u003B-\\u007E]+$"
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[\\u0020-\\u007E]+$"
    }
  }
}
